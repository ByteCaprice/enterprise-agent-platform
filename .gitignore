# Root is an allowlist. New top-level files/folders require distribution review.
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/pyproject.toml
!/uv.lock
!/MANIFEST.in
!/domain/
!/framework/
!/infra/
!/interfaces/
!/orchestration/
!/tests/
!/docs/
!/scripts/
!/docker/

# Private configuration, including misleading names such as .env_new.
.[eE][nN][vV]*
*.env
*.env.*
*.local
*.local.*
dev-config*.txt
.pypirc
.npmrc
.netrc
.gitconfig
.git-credentials
pip.conf
private/
secrets/
credentials/
.ssh/
.aws/
.azure/
.kube/
.gcloud/
.terraform/
.hg/
.svn/
id_rsa
id_ed25519
id_ecdsa
*.pem
*.key
*.pub
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.*

# Documents and structured data are private unless explicitly reviewed below.
*.[mM][dD]
*.rst
*.adoc
*.txt
*.[jJ][sS][oO][nN]
*.[yY][aA][mM][lL]
*.[yY][mM][lL]
*.jsonl
*.ndjson
*.ipynb
!/README.md
!/CONTRIBUTING.md
/docs/*
!/docs/README.md
!/docs/overview.md
!/docs/api.md
!/docs/frontend-integration.md
!/docs/deployment.md
!/docs/development.md
!/docs/roadmap.md
!/docs/repository-policy.md
/docs/internal/
!/tests/fixtures/trade_documents/README.md
!/framework/agent_runtime/pi/node/package.json
!/framework/agent_runtime/pi/node/package-lock.json

# Private operational material is not a platform runtime asset.
/config/
/rebuild-guide.md
/AI-Platform-*.html

# Only reviewed, generic operator/development helpers enter the remote repository.
/scripts/*
!/scripts/backup_platform.py
!/scripts/bootstrap_platform_sit.py
!/scripts/build_platform_release.py
!/scripts/check_repository_files.py
!/scripts/test_database_config.py
!/scripts/repository_policy.py

# Only the new-platform recipe and empty templates are distributable.
/docker/*
!/docker/platform/
/docker/platform/*
!/docker/platform/Dockerfile
!/docker/platform/Dockerfile.dockerignore
!/docker/platform/compose.yaml
!/docker/platform/app.env.example
!/docker/platform/deployment-policy.example.json

# Customer/binary examples need provenance review; retain only the usage notice.
/tests/fixtures/*
!/tests/fixtures/trade_documents/
/tests/fixtures/trade_documents/*
!/tests/fixtures/trade_documents/README.md
*.pdf
*.docx
*.xlsx
*.csv
*.png
*.jpg
*.jpeg
*.npy
*.npz
*.parquet
*.arrow
*.feather
*.pkl
*.pickle
*.joblib
*.onnx
*.safetensors
*.pt
*.pth

# Editors, assistants, local plans and browser artifacts.
.idea/
.vscode/
.claude/
.codex/
.cursor/
.pi/
.aider*
AGENTS.md
CLAUDE.md
GEMINI.md
*.iml
*.code-workspace
.DS_Store
*.swp
*.swo
*~
.playwright-mcp/
playwright-report/
test-results/
screenshots/
recordings/
.local-deploy/
.local/
temp/
tmp/
openai-agents-python/

# Dependency installations, caches and build output (lockfiles remain reviewed source).
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
*.egg
*.whl
build/
dist/
node_modules/
.next/
out/
*.tsbuildinfo

# Runtime data, traces, backups and exports, never platform migration source SQL.
var/
logs/
backups/
exports/
*.log
*.pid
*.db
*.sqlite*
*.dump
*.dump.*
*.backup
*.bak
*.sql.gz
*.sql.zip
*.har
*.pcap
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
