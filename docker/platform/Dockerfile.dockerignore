# Deny the entire build context, then allow only reviewed runtime source roots.
**
!pyproject.toml
!uv.lock
!README.md
!domain/
!domain/**
!infra/
!infra/**
!framework/
!framework/**
!orchestration/
!orchestration/**
!interfaces/
!interfaces/**

# Strip structured documentation/data except the exact Pi runtime package metadata.
**/*.md
**/*.rst
**/*.json
**/*.yaml
**/*.yml
!README.md
!framework/agent_runtime/pi/node/package.json
!framework/agent_runtime/pi/node/package-lock.json

# Final denials win even inside otherwise-allowed runtime source paths.
**/.git
**/.git/**
.git
.git/**
**/private/**
**/secrets/**
**/credentials/**
**/.local/**
**/.local-deploy/**
