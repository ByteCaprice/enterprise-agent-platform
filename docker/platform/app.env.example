# Copy OUTSIDE the repository to the operator config directory as .env.
# Do not mount a directory containing provider secrets or the plaintext bootstrap admin Key.
DATABASE__BACKEND=postgresql
DATABASE__HOST=
DATABASE__PORT=5432
DATABASE__NAME=
DATABASE__USER=
DATABASE__PASSWORD=
DATABASE__SCHEMA=enterprise_ai
DATABASE__SSLMODE=verify-full
# Mount the reviewed public CA certificate if your database uses a private CA.
# DATABASE__SSLROOTCERT=/etc/enterprise-ai/db-ca.pem
# Technical timeouts for the API/Workers, not the offline migration process.
DATABASE__CONNECT_TIMEOUT_SECONDS=10
DATABASE__POOL_TIMEOUT_SECONDS=10
DATABASE__STATEMENT_TIMEOUT_MS=15000
DATABASE__LOCK_TIMEOUT_MS=5000
SERVER__HOST=127.0.0.1
SERVER__PORT=50020
PLATFORM_RUNTIME__MODE=trial
PLATFORM_RUNTIME__WORKER_STALE_SECONDS=45
PLATFORM_RUNTIME__QUEUE_WARNING_SECONDS=300
# Production refuses startup without a valid explicit policy file.
# PLATFORM_RUNTIME__MODE=production
# PLATFORM_RUNTIME__POLICY_FILE=deployment-policy.json
